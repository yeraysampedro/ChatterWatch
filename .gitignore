# Keep the repository root limited to source, development and public project files.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.github/
!/README.md
!/AGENTS.md
!/deno.json
!/deno.lock
!/src/
!/build/
!/tests/
!/docs/
!/LICENSE
!/LICENSE.*
!/NOTICE
!/NOTICE.*

# Local configuration, credentials and private account data (at any depth).
.env
.env.*
.envrc
.direnv/
*.local
*.local.*
.secrets/
secrets/
.credentials*
credentials*.json
credentials*.yaml
credentials*.yml
*.secret
*.token
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
.ssh/
.gnupg/
.netrc
_netrc
.git-credentials
example_accounts.md
chatter-*.txt
exports/

# Owner-only Windows launchers (publishing, local test runs). Use the deno tasks
# documented in README.md instead; launchers stay on the owner's machine.
*.bat
*.cmd

# Store-reviewer notes may contain test-account access: never version them, even
# if copied out of dist/. Regenerate with `deno task store:submission`.
PRIVATE-*
store-submission/

# Mozilla web-ext signing state and artifacts.
web-ext-artifacts/
.web-extension-id
.amo-upload-uuid

# Placeholder-only environment templates may be versioned; never real credentials.
!.env.example
!.env.template

# Dependencies, caches and generated outputs. Keep deno.lock versioned.
node_modules/
.deno/
.npm/
.pnpm-store/
.cache/
dist/
coverage/
test-results/
playwright-report/
*.zip
*.xpi
*.crx
*.tsbuildinfo
*.log

# Machine-specific editor settings and temporary files.
.vscode/
.idea/
.vs/
.history/
*.code-workspace
*.swp
*.swo
*.tmp
*.bak
*~
.DS_Store
Thumbs.db
Desktop.ini
