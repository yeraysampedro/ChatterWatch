# Keep the repository root limited to source, development and public project files.
/*
!/.gitignore
!/.gitattributes
!/.editorconfig
!/.github/
!/README.md
!/AGENTS.md
!/deno.json
!/deno.lock
!/src/
!/build/
!/tests/
!/docs/
!/LICENSE
!/LICENSE.*
!/NOTICE
!/NOTICE.*

# Local configuration, credentials and private account data (at any depth).
.env
.env.*
.envrc
.direnv/
*.local
*.local.*
.secrets/
secrets/
.credentials*
credentials*.json
credentials*.yaml
credentials*.yml
*.secret
*.token
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
.ssh/
.gnupg/
example_accounts.md
chatter-*.txt
exports/

# Placeholder-only environment templates may be versioned; never real credentials.
!.env.example
!.env.template

# Dependencies, caches and generated outputs. Keep deno.lock versioned.
node_modules/
.deno/
.npm/
.pnpm-store/
.cache/
dist/
coverage/
test-results/
playwright-report/
*.zip
*.xpi
*.crx
*.tsbuildinfo
*.log

# Machine-specific editor settings and temporary files.
.vscode/
.idea/
.vs/
.history/
*.code-workspace
*.swp
*.swo
*.tmp
*.bak
*~
.DS_Store
Thumbs.db
Desktop.ini
